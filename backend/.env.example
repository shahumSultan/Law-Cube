# Copy this file to .env and fill in your values
# cp .env.example .env

APP_ENV=development
DEBUG=true
SECRET_KEY=               # openssl rand -hex 32

DATABASE_URL=postgresql+asyncpg://lawcube:lawcube@postgres:5432/lawcube
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_CALLS=law-cube-calls
MINIO_BUCKET_DOCS=law-cube-docs
MINIO_SECURE=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=          # OAuth client ID for Google Sign-In
GOOGLE_API_KEY=
AI_PRIMARY_PROVIDER=openai

# Transcription providers (at least one required for call processing)
# Free-tier options: Deepgram (12k min/year) and AssemblyAI (100 hours)
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
TRANSCRIPTION_PRIMARY_PROVIDER=openai  # openai | deepgram | assemblyai
TRANSCRIPTION_MOCK=TRUE               # Set to true to skip real transcription (dev/test)

CALLRAIL_API_KEY=
CALLRAIL_WEBHOOK_SECRET=
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
